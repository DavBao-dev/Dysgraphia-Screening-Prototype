# Private deployment only. These are server-side variables; never NEXT_PUBLIC_ variables.
# Verify login/authorization on ALL pages, /api routes and direct backend access before enabling.
CONSENT_PRIVATE_ACCESS_VERIFIED=false
# Enable only when all persisted screening data uses the private Supabase store and retention is verified.
CONSENT_SUPABASE_STORAGE_VERIFIED=false
CONSENT_APP_LOCATION=
CONSENT_SIGNING_KEY=
# Your Supabase project must actually be in Singapore. Service role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Demo repository: build with NEXT_PUBLIC_DEMO_MODE=0 / DEMO_MODE=0 for actual screening.
